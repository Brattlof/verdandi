  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "1.4.2",
    "bun-plugin-tailwind": "0.1.2",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [],
  "overrides": {
    "effect": "4.0.0-rc.115",
    "@effect/platform-node-shared": "4.0.0-rc.115"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
